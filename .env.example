# GEMINI_API_KEY: Optional. Enables live Gemini responses for the Mentor and Nigel Studio.
# Without it, the API serves built-in offline answers. AI Studio injects it from user secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Optional. Overrides the default Gemini model used by the server.
# GEMINI_MODEL="gemini-3.8-flash"

# PORT: Optional. HTTP port (default 3000).
# PORT=3000

# RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS: Optional. Per-IP request budget for the AI endpoints
# (defaults: 30 requests per 60000 ms).
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000

# APP_URL: The URL where this applet is hosted. AI Studio injects the Cloud Run URL.
APP_URL="MY_APP_URL"
